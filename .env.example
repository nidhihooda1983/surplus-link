# SurplusLink Lead Generation Engine Configuration Example

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# SerpApi Credentials (from https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key

# Engine Parameters
SEARCH_RADIUS_KM=5.0
MAX_LEADS_PER_LISTING=3
POLL_INTERVAL_SECONDS=5

# Set to true to test with mock listings and simulated SerpApi results
MOCK_MODE_IF_UNCONFIGURED=true
